{
  "name": "injurybug",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "injurybug",
      "database_id": "af7820d9-273d-4b10-84c0-f5cef27b0bca",
      "migrations_dir": "migrations"
    }
  ],
  // The React build from web/ (`npm run build` there; `npm run deploy` here builds it first).
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
